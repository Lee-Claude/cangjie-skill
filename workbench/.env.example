# 复制成 .env.local 后填写。.env.local 已在 .gitignore 里，不会被提交。

# ── 模型（二选一，Claude 优先）───────────────────────────────
# 方案 A：Claude（推荐）
ANTHROPIC_API_KEY=
# 可选：默认 claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5
# 可选：low | medium | high | xhigh | max，默认 high
# ANTHROPIC_EFFORT=high
# 可选：thinking 和正文共用这个额度，默认 64000
# ANTHROPIC_MAX_TOKENS=64000

# 方案 B：任何 OpenAI 兼容接口（DeepSeek / Kimi / 通义 / 本地 vLLM…）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 两个都配了想强制用某一个：anthropic | openai
# LLM_PROVIDER=anthropic

# ── 热点数据源 ──────────────────────────────────────────────
# 自建 AI 热榜服务的 API 地址（如 ai-hot-radar / aihot），留空则不启用
# AIHOT_API_BASE=http://localhost:3001/api/agent
# AIHOT_API_PATH=/curated
# AIHOT_API_TOKEN=

# GitHub token，把 search API 限速从 10 次/分钟提到 30 次/分钟
# GITHUB_TOKEN=

# 自定义 RSS 源，格式：名称|地址，多个用英文逗号分隔
# HOT_RSS_FEEDS=量子位|https://www.qbitai.com/feed,机器之心|https://www.jiqizhixin.com/rss

# 热点缓存时长（毫秒），默认 5 分钟
# HOT_CACHE_TTL_MS=300000
